# AutomateAI Project Environment Variables
# Copy this to backend/.env and frontend/.env respectively

# --- Backend Configuration (backend/.env) ---
GROQ_API_KEY=
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=https://api.groq.com/openai/v1

DATABASE_URL=sqlite:///./automateai.db
JWT_SECRET=your-secure-jwt-secret-change-in-production
JWT_EXPIRE_MINUTES=1440

# Demo data seeding (true = automatically seed demo user & CRM data)
SEED_DEMO_DATA=true

# CORS configuration (comma-separated allowed origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional SMTP Settings for Live Email Delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Optional n8n Webhook
N8N_WEBHOOK_URL=

# --- Frontend Configuration (frontend/.env) ---
VITE_API_URL=http://127.0.0.1:8000
